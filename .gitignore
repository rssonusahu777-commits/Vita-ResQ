build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Pub
pubspec.lock

# IDE
.idea/
.vscode/
*.iml
*.ipr
*.iws

# macOS
.DS_Store

# Windows
Thumbs.db

# Android
android/.gradle/
android/local.properties
android/key.properties

# iOS
ios/.symlinks/
ios/Pods/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Hive boxes generated during tests (temp dirs are cleaned up, but just in case)
*.hive
*.lock
